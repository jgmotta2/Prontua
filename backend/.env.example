# ============================================================================
# SERENO — Backend Environment
# ============================================================================
# Nunca comite o .env real. Use um secrets manager em produção
# (AWS Secrets Manager, GCP Secret Manager, HashiCorp Vault).
# ============================================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Database (PostgreSQL) --------------------------------------------------
# Dev local (docker compose): use 5432 direto, sem PgBouncer — ver README.md.
DATABASE_URL="postgresql://sereno:sereno_dev_only@localhost:5432/sereno"
DIRECT_URL="postgresql://sereno:sereno_dev_only@localhost:5432/sereno"
# Produção com PgBouncer: DATABASE_URL na porta do pool (ex.: 6432) + DIRECT_URL na 5432.

# ---- HTTP / CORS -----------------------------------------------------------
# Origens permitidas separadas por vírgula. NUNCA use '*' em produção.
CORS_ORIGINS="http://localhost:5173,https://app.sereno.health"
COOKIE_DOMAIN=".sereno.health"
TRUST_PROXY=1

# ---- JWT (HS256 para MVP; RS256 com KMS recomendado em prod) ---------------
# Gere com: openssl rand -base64 64
JWT_ACCESS_SECRET="REPLACE_WITH_64_BYTES_BASE64_RANDOM"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_64_BYTES_BASE64_RANDOM"
JWT_ACCESS_TTL=900            # 15 minutos (segundos)
JWT_REFRESH_TTL=2592000       # 30 dias (segundos)
JWT_ISSUER="sereno-api"
JWT_AUDIENCE="sereno-app"

# ---- Application-Layer Encryption (AES-256-GCM) ----------------------------
# Master key para criptografar prontuários clínicos (SessionNote).
# Gere com: openssl rand -base64 32  (32 bytes = AES-256)
# Em produção: armazene em KMS (AWS KMS, GCP KMS) e rotacione periodicamente.
ENCRYPTION_MASTER_KEY="REPLACE_WITH_32_BYTES_BASE64_RANDOM"
ENCRYPTION_KEY_VERSION=1

# Pepper aplicado a hashes determinísticos (lookup de CPF, hash de IP).
# Sem o pepper, rainbow tables não funcionam mesmo com vazamento de hash.
HASH_PEPPER="REPLACE_WITH_32_BYTES_BASE64_RANDOM"

# ---- Argon2id (hashing de senha) -------------------------------------------
ARGON_MEMORY_COST=65536        # 64 MB
ARGON_TIME_COST=3
ARGON_PARALLELISM=1

# ---- Rate Limiting (Redis em prod, memória em dev) -------------------------
REDIS_URL="redis://localhost:6379"
RATE_LIMIT_LOGIN_PER_15MIN=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_API_PER_MIN=60

# ---- Z-API (WhatsApp) ------------------------------------------------------
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
ZAPI_CLIENT_TOKEN=""
ZAPI_BASE_URL="https://api.z-api.io"
ZAPI_WEBHOOK_SECRET="REPLACE_WITH_RANDOM_STRING"

# ---- Frontend URL (para links de email, redirect) --------------------------
FRONTEND_URL="http://localhost:5173"

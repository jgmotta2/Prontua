# URL da API. Em dev, deixamos o caminho relativo '/api' que o Vite
# faz proxy para o backend (vite.config.ts) — assim o cookie HttpOnly
# trafega como mesma origem.
VITE_API_BASE_URL=/api

# Alvo do proxy de dev (consumido apenas pelo Vite, não pela aplicação).
VITE_API_PROXY_TARGET=http://localhost:4000

# Em produção, configure VITE_API_BASE_URL=https://api.prontua.com.br

# ============================================================================
# PRONTUA — Backend Environment
# ============================================================================
# NUNCA commite o .env real. Use um secrets manager em produção
# (AWS Secrets Manager, GCP Secret Manager, HashiCorp Vault).
#
# Para gerar segredos:
#   JWT secrets:       openssl rand -hex 64
#   Encryption key:    openssl rand -base64 32
#   Hash pepper:       openssl rand -hex 16
# ============================================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Banco de Dados ───────────────────────────────────────────────────────────
# DEV (SQLite local): use caminho absoluto para evitar ambiguidade de cwd
DATABASE_URL="file:/caminho/absoluto/para/o/projeto/sereno-mvp/backend/prisma/dev.db"
DIRECT_URL="file:/caminho/absoluto/para/o/projeto/sereno-mvp/backend/prisma/dev.db"

# PRODUÇÃO (PostgreSQL via PgBouncer):
# DATABASE_URL="postgresql://user:senha@pgbouncer-host:6432/prontua?pgbouncer=true&connection_limit=20"
# DIRECT_URL="postgresql://user:senha@postgres-host:5432/prontua"

# ── HTTP / CORS ──────────────────────────────────────────────────────────────
# Origens permitidas separadas por vírgula. NUNCA use '*' em produção.
CORS_ORIGINS="http://localhost:4000,http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
TRUST_PROXY=0

# Em produção:
# CORS_ORIGINS="https://app.prontua.com.br"
# FRONTEND_URL="https://app.prontua.com.br"
# COOKIE_DOMAIN=".prontua.com.br"
# TRUST_PROXY=1

# ── JWT (HS256 para MVP; RS256 com KMS recomendado em prod) ─────────────────
# Gere com: openssl rand -hex 64
JWT_ACCESS_SECRET="REPLACE_WITH_64_BYTES_HEX_RANDOM"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_64_BYTES_HEX_RANDOM"
JWT_ACCESS_TTL=900            # 15 minutos (segundos)
JWT_REFRESH_TTL=2592000       # 30 dias (segundos)
JWT_ISSUER="prontua-api"
JWT_AUDIENCE="prontua-app"

# ── Criptografia de prontuários (AES-256-GCM) ─────────────────────────────
# Gere com: openssl rand -base64 32  (32 bytes = AES-256)
# Em produção: armazene em KMS (AWS KMS, GCP KMS) e rotacione periodicamente.
ENCRYPTION_MASTER_KEY="REPLACE_WITH_32_BYTES_BASE64_RANDOM"
ENCRYPTION_KEY_VERSION=1

# Pepper aplicado a hashes determinísticos (lookup de CPF, hash de IP).
# Gere com: openssl rand -hex 16
HASH_PEPPER="REPLACE_WITH_32_HEX_CHARS"

# ── Argon2id (hashing de senha) ──────────────────────────────────────────────
# DEV (rápido para iterar):
ARGON_MEMORY_COST=4096
ARGON_TIME_COST=2
ARGON_PARALLELISM=1

# PRODUÇÃO (OWASP 2024 recomenda mínimo 19MB, timeCost 2):
# ARGON_MEMORY_COST=65536
# ARGON_TIME_COST=3
# ARGON_PARALLELISM=1

# ── Rate Limiting ────────────────────────────────────────────────────────────
# DEV (valores altos para não atrapalhar desenvolvimento):
RATE_LIMIT_LOGIN_PER_15MIN=20
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_API_PER_MIN=200

# PRODUÇÃO (valores restritivos):
# RATE_LIMIT_LOGIN_PER_15MIN=5
# RATE_LIMIT_REGISTER_PER_HOUR=3
# RATE_LIMIT_API_PER_MIN=60
# REDIS_URL="redis://localhost:6379"

# ── E-mail transacional (Resend) ─────────────────────────────────────────────
# Crie sua chave em resend.com — plano grátis: 3.000 e-mails/mês
RESEND_API_KEY="re_REPLACE_WITH_YOUR_KEY"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ── WhatsApp (Z-API) ─────────────────────────────────────────────────────────
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
ZAPI_CLIENT_TOKEN=""
ZAPI_BASE_URL="https://api.z-api.io"
ZAPI_WEBHOOK_SECRET="REPLACE_WITH_RANDOM_STRING"

# ── Módulo de Voz (IA) ────────────────────────────────────────────────────────
# Conta OpenAI deve ter "Zero Data Retention" habilitado em:
# https://platform.openai.com/settings/organization/data-controls
# Dados de saúde NÃO podem ser usados para treinamento da OpenAI (LGPD/HIPAA).
OPENAI_API_KEY="sk-REPLACE_WITH_YOUR_OPENAI_KEY"
OPENAI_MODEL_TRANSCRIPTION="whisper-1"
OPENAI_MODEL_REPORT="gpt-4o"
RATE_LIMIT_AUDIO_PER_MIN=2

# ── TCLE (Termo de Consentimento) ────────────────────────────────────────────
TCLE_VERSION="v1.0"

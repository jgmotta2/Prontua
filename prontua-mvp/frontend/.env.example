# ══════════════════════════════════════════════════════════════════════════════
# PRONTUA — Frontend environment variables
# ══════════════════════════════════════════════════════════════════════════════

# URL da API. Em dev, deixa vazio — Vite faz proxy para o backend local.
# Em produção com Railway single-service (backend serve o frontend),
# também deixa vazio (usa '/api' relativo ao mesmo domínio).
# Só preencha se frontend e backend estiverem em domínios SEPARADOS.
# VITE_API_BASE_URL=https://api.seu-dominio.com

# Alvo do proxy local (só usado em desenvolvimento)
VITE_API_PROXY_TARGET=http://localhost:4000

// ============================================================================
// PRONTUA — Prisma Schema (PostgreSQL)
// Strings armazenam JSON manualmente (compatibilidade SQLite → PG mantida)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  patients        Patient[]
  sessions        Session[]
  payments        Payment[]
  notes           SessionNote[]
  auditLogs       AuditLog[]
  whatsappLogs    WhatsappLog[]
  patientConsents PatientConsent[]
  voiceReports    VoiceSessionReport[]

  @@map("tenants")
}

model User {
  id           String @id @default(uuid())
  tenantId     String

  email        String
  passwordHash String
  name         String
  whatsapp     String
  city         String
  state        String
  specialty    String
  registry     String?

  role   String  @default("OWNER")
  active Boolean @default(true)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  verificationCode       String?
  verificationCodeExpiry DateTime?

  photo        String? // base64 data URL da foto de perfil (max ~1.5 MB comprimido)

  mfaEnabled   Boolean @default(false)
  mfaSecretEnc String?
  mfaSecretIv  String?
  mfaSecretTag String?

  passwordChangedAt DateTime @default(now())
  failedLoginCount  Int      @default(0)
  lockedUntil       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions      Session[]      @relation("ProfessionalSessions")
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  authoredNotes SessionNote[]  @relation("NoteAuthor")
  voiceReports  VoiceSessionReport[] @relation("VoiceReportAuthor")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  ipHash    String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model Patient {
  id       String @id @default(uuid())
  tenantId String

  fullName  String
  birthDate DateTime?
  email     String?
  whatsapp  String

  documentEnc  String?
  documentIv   String?
  documentTag  String?
  documentHash String? @unique

  notesGeneral String?

  tags         String  @default("[]")
  sessionValue Decimal @default(0)
  frequencyTag String?

  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions Session[]
  payments Payment[]
  consents PatientConsent[]

  @@index([tenantId])
  @@index([tenantId, fullName])
  @@index([tenantId, deletedAt])
  @@map("patients")
}

model Session {
  id             String @id @default(uuid())
  tenantId       String
  patientId      String
  professionalId String

  scheduledAt DateTime
  durationMin Int     @default(50)
  mode        String  @default("PRESENCIAL")
  value       Decimal
  status      String  @default("SCHEDULED")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  professional User       @relation("ProfessionalSessions", fields: [professionalId], references: [id], onDelete: Restrict)
  note         SessionNote?
  payment      Payment?
  voiceReport  VoiceSessionReport?

  @@index([tenantId])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, patientId])
  @@index([tenantId, deletedAt])
  @@map("sessions")
}

model SessionNote {
  id        String @id @default(uuid())
  tenantId  String
  sessionId String @unique
  authorId  String

  contentEnc String
  contentIv  String
  contentTag String
  keyVersion Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author  User    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("session_notes")
}

model Payment {
  id        String  @id @default(uuid())
  tenantId  String
  patientId String
  sessionId String? @unique

  amount  Decimal
  status  String  @default("PENDING")
  method  String?
  paidAt  DateTime?
  dueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("payments")
}

model AuditLog {
  id       String  @id @default(uuid())
  tenantId String?
  userId   String?

  action       String
  resourceType String?
  resourceId   String?

  ipHash    String?
  userAgent String?
  metadata  String?

  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model WhatsappLog {
  id        String  @id @default(uuid())
  tenantId  String
  patientId String?

  kind       String
  template   String
  status     String  @default("QUEUED")
  externalId String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("whatsapp_logs")
}

model PatientConsent {
  id        String @id @default(uuid())
  tenantId  String
  patientId String

  termVersion  String
  signedIpHash String
  recordedById String
  agreedAt     DateTime @default(now())
  revokedAt    DateTime?
  active       Boolean  @default(true)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("patient_consents")
}

model VoiceSessionReport {
  id        String @id @default(uuid())
  tenantId  String
  sessionId String @unique
  authorId  String

  rawTranscription String
  structuredReport String
  pdfStorageKey    String?
  isFinalized      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author  User    @relation("VoiceReportAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("voice_session_reports")
}
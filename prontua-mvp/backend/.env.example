# ══════════════════════════════════════════════════════════════════════════════
# PRONTUA — Backend environment variables
# Copie para .env e preencha. NUNCA commite o .env real.
# ══════════════════════════════════════════════════════════════════════════════

# ── Banco de dados (PostgreSQL) ───────────────────────────────────────────────
# Neon (gratuito): https://neon.tech  →  Settings > Connection string
# Railway: gerado automaticamente ao adicionar serviço PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ── Ambiente ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://seu-dominio.com
CORS_ORIGINS=https://seu-dominio.com
COOKIE_DOMAIN=seu-dominio.com
TRUST_PROXY=1

# ── JWT ──────────────────────────────────────────────────────────────────────
# Gere: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=SUBSTITUA-min-32-chars-aleatorio
JWT_REFRESH_SECRET=SUBSTITUA-min-32-chars-diferente
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=prontua-api
JWT_AUDIENCE=prontua-app

# ── Criptografia dos prontuários ──────────────────────────────────────────────
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Deve ter exatamente 44 chars (32 bytes em base64 com padding)
ENCRYPTION_MASTER_KEY=SUBSTITUA-base64-de-32-bytes
ENCRYPTION_KEY_VERSION=1
# Gere: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HASH_PEPPER=SUBSTITUA-min-16-chars

# ── Argon2 ───────────────────────────────────────────────────────────────────
ARGON_MEMORY_COST=65536
ARGON_TIME_COST=3
ARGON_PARALLELISM=1

# ── E-mail (Resend) ───────────────────────────────────────────────────────────
# Gratuito até 3.000 emails/mês: https://resend.com
RESEND_API_KEY=re_SUBSTITUA
RESEND_FROM_EMAIL=noreply@seu-dominio.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_15MIN=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_API_PER_MIN=60
RATE_LIMIT_LISTA_ESPERA_PER_HOUR=10
# REDIS_URL=redis://...   # opcional — usa memory store sem Redis

# ── Admin da plataforma (lista de espera da landing) ─────────────────────────
# E-mails separados por vírgula OU flag isAdministradorPlataforma no usuário
EMAILS_ADMIN_PLATAFORMA=prontuasoftware@gmail.com

# ── OpenAI (prontuário por voz) — opcional ────────────────────────────────────
# OPENAI_API_KEY=sk-...
OPENAI_MODEL_TRANSCRIPTION=whisper-1
OPENAI_MODEL_REPORT=gpt-4o
RATE_LIMIT_AUDIO_PER_MIN=2

# ── WhatsApp Z-API — requer plano pago ───────────────────────────────────────
# ZAPI_INSTANCE_ID=
# ZAPI_TOKEN=
# ZAPI_CLIENT_TOKEN=
# ZAPI_WEBHOOK_SECRET=
ZAPI_BASE_URL=https://api.z-api.io

# ── TCLE ─────────────────────────────────────────────────────────────────────
TCLE_VERSION=v1.0
